<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: #121212; -fx-border-color: #121212;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox style="-fx-background-color: #121212;">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E1E1E; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 5);">
                    <padding>
                        <Insets bottom="15" left="30" right="30" top="15" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="5">
                            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Cine" />
                            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E50914;" text="TEC" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: #333333; -fx-background-radius: 20; -fx-padding: 5 15;">
                            <TextField fx:id="txtBuscar" promptText="Buscar pelicula" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #888888;" />
                        </HBox>

                        <MenuButton style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;" text="Mi Cuenta">
                            <items>
                                <MenuItem text="Boletos" />
                                <MenuItem text="Cerrar sesion" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <StackPane prefHeight="288.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to right, #2c0000, #300000); -fx-background-radius: 0 0 20 20;"> <children>

                    <VBox alignment="CENTER_LEFT" spacing="15" StackPane.alignment="CENTER_LEFT">
                        <padding>
                            <Insets left="50.0" /> </padding>
                        <Label minHeight="-Infinity" minWidth="-Infinity" prefHeight="70.0" prefWidth="394.0" style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, black, 10, 0.5, 0, 0);" text="¡YA DISPONIBLE!" />
                        <Button style="-fx-font-size: 16px; -fx-padding: 10 30;" styleClass="action-btn" text="Ver Funciones" />
                    </VBox>

                </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </VBox.margin>
                </StackPane>

                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="En Cartelera">
                    <padding>
                        <Insets bottom="10.0" left="40.0" />
                    </padding>
                </Label>

                <TilePane fx:id="tileCartelera" hgap="30.0" prefColumns="4" style="-fx-padding: 0 40 40 40;" vgap="30.0">
                    <children>
                    </children>
                </TilePane>

            </children>
        </VBox>
    </content>
</ScrollPane>
