<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <style>
        -fx-background-color: #121212; /* Fondo de la app */
    </style>

    <VBox alignment="CENTER" maxWidth="450.0" prefHeight="550.0" prefWidth="400.0" spacing="20.0" style="-fx-background-color: #1E1E1E; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, black, 20, 0.5, 0, 0);">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <children>
            <HBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Cine" />
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #E50914;" text="TEC" />
            </HBox>

            <VBox spacing="5.0">
                <Label style="-fx-text-fill: white;" text="Nombre de Usuario" />
                <TextField fx:id="txtNombre" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #444444; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-text-fill: white;" text="Correo Electronco " />
                <TextField fx:id="txtEmail" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #444444; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-text-fill: white;" text="Contraseña" />
                <PasswordField fx:id="txtPassword" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #444444; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-text-fill: white;" text="Confirmar Contraseña" />
                <PasswordField fx:id="txtConfirmPassword" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #444444; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </VBox>

            <Button fx:id="btnRegister" maxWidth="1.7976931348623157E308" styleClass="action-btn" text="Registrarse" VBox.vgrow="NEVER" />

            <HBox alignment="CENTER" spacing="5.0">
                <Label fx:id="lblGoToLogin" style="-fx-text-fill: #E50914; -fx-cursor: hand;" text="Iniciar Sesión" />
            </HBox>

        </children>
    </VBox>
</StackPane>
