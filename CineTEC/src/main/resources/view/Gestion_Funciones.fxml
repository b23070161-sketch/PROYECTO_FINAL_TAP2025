<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button minWidth="100.0" style="-fx-text-fill: white;" styleClass="action-btn" text="Volver" />

                <Label styleClass="header-title" text="Programacion de funciones" />

                <Region HBox.hgrow="ALWAYS" />

                <Label style="-fx-text-fill: white;" text="Fecha:" />
                <DatePicker prefWidth="150.0" styleClass="combo-box" />
                <Button styleClass="action-btn" text="Crear funcion" />
            </children>
        </HBox>

        <TableView VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Hora inicio" />
                <TableColumn text="Pelicula" />
            <TableColumn text="Hora Fin" />
                <TableColumn text="Sala" />
                <TableColumn text="Tipo de sala" />
                <TableColumn text="Asientos vendidos" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
