<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Button minWidth="100.0" style="-fx-text-fill: white;" styleClass="action-btn" text="Volver" />

                <Label styleClass="header-title" text="Catalogo de peliculas" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField prefWidth="250.0" promptText="Buscar pelicula" />
                <Button styleClass="action-btn" text="Nueva pelicula" />
            </children>
        </HBox>

        <TableView VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="50.0" text="ID" />
                <TableColumn prefWidth="250.0" text="Titulo" />
                <TableColumn prefWidth="150.0" text="Genero" />
                <TableColumn prefWidth="100.0" text="Duracion" />
                <TableColumn prefWidth="100.0" text="Clasificacion" />
                <TableColumn prefWidth="120.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>
